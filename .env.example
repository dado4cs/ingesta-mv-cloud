# ============================================================
#  .env.example — Ingesta MV Cloud
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env a Git.
# ============================================================

# ── PostgreSQL (backend_catalogo) ───────────────────────────
PG_HOST=<ip-o-host-de-postgres>
PG_PORT=5432
PG_DB=cinema_catalog
PG_USER=postgres
PG_PASSWORD=<contraseña-postgres>

# ── MySQL (backend_comunity) ────────────────────────────────
MYSQL_HOST=<ip-o-host-de-mysql>
MYSQL_PORT=3306
MYSQL_DB=community_db
MYSQL_USER=community
MYSQL_PASSWORD=<contraseña-mysql>

# ── MongoDB (frontend) ──────────────────────────────────────
MONGO_URI=mongodb://<ip-o-host-de-mongo>:27017
MONGO_DB=frontend_db
# Lista separada por comas de colecciones a extraer
MONGO_COLLECTIONS=sessions,notifications,preferences,activity_logs

# ── AWS ─────────────────────────────────────────────────────
S3_BUCKET=<nombre-de-tu-bucket-s3>
AWS_REGION=us-east-1

# Si corres en una EC2 con Rol IAM: NO necesitas estas variables.
# Si corres fuera de AWS con credenciales de usuario IAM, descomenta:
# AWS_ACCESS_KEY_ID=<tu-access-key-id>
# AWS_SECRET_ACCESS_KEY=<tu-secret-access-key>
